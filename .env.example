# ==============================================================================
# NiyamSetu Frontend Environment Configuration
# ==============================================================================
# Copy this file to `.env` or `.env.local` in the frontend folder.
# NOTE: All VITE_* variables are bundled into client-side JS and are PUBLIC.
# NEVER put secrets, passwords, or API keys here!
# ==============================================================================

# Set to true to run fully offline with mocks (shows MOCK banner in UI)
VITE_USE_MOCKS=false

# Backend Server URL for Vite dev proxy (defaults to http://localhost:8000)
VITE_BACKEND_URL=http://localhost:8000
